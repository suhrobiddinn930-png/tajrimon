# Server only. Never copy this file into mobile assets or --dart-define.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
ROOM_CODE_PEPPER=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Uzbek is experimental and disabled until a bilingual device acceptance test.
ENABLED_LANGUAGES=en,de,ru,tr
EXPERIMENTAL_UZBEK=false
# Operator-supplied conservative estimate, NOT a provider pricing quote.
ESTIMATED_USD_PER_MINUTE=0.10
